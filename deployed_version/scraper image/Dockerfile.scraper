# Lightweight CPU-only ECS Fargate Scraper Container
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements-scraper.txt /app/requirements-scraper.txt
RUN pip install --upgrade pip && \
    pip install -r /app/requirements-scraper.txt && \
    useradd --create-home --shell /bin/bash scraperuser

COPY scraper.py /app/scraper.py
RUN chown -R scraperuser:scraperuser /app

USER scraperuser

ENTRYPOINT ["python", "scraper.py"]
